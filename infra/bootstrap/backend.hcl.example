# Copy to backend.hcl (not committed) and use the state_bucket_name output.
bucket       = "rail-aws-rag-tfstate-<account-id>"
key          = "bootstrap/terraform.tfstate"
region       = "eu-west-1"
encrypt      = true
use_lockfile = true # native S3 locking, Terraform 1.10 or later: no DynamoDB table
